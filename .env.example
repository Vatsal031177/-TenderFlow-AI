# Database & Search
DATABASE_URL=postgresql+psycopg2://tendos:tendos@postgres:5432/tendos
ELASTICSEARCH_URL=http://elasticsearch:9200

# LLM Gateway (Leave empty to use built-in deterministic fallback mode)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# LangSmith Observability (Optional)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=tenderflow-ai

# Guardrails
MIN_MARGIN_PERCENT=18.0
CONFIDENCE_REVIEW_THRESHOLD=0.75

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
